# Copy to .env.local. The project is learn-spanish; its keys are under Project
# Settings → API Keys, or `supabase projects api-keys --project-ref sbouiweyksuiakajkrbt`.

# The app's browser client. Public: row-level security guards the data.
NEXT_PUBLIC_SUPABASE_URL=https://sbouiweyksuiakajkrbt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Scripts only (npm run check:rls). Bypasses row-level security: never use it in
# the app or add it to Vercel.
SUPABASE_SECRET_KEY=sb_secret_...
