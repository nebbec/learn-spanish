{
  "format": 2,
  "version": 7,
  "units": [
    {
      "id": "me-and-you",
      "title": "Me and you",
      "goal": "greet someone, say yes or no, and say please and thank you."
    },
    {
      "id": "who-i-am",
      "title": "Who I am",
      "goal": "say your name and where you are from."
    },
    {
      "id": "how-and-where-i-am",
      "title": "How and where I am",
      "goal": "ask how someone is, and say how and where you are."
    },
    {
      "id": "what-i-want-and-have",
      "title": "What I want and have",
      "goal": "say what you want and what you have."
    },
    {
      "id": "my-people",
      "title": "My people",
      "goal": "talk about the people in your life."
    },
    {
      "id": "what-people-are-like",
      "title": "What people are like",
      "goal": "describe people and things: good, big, new, happy, tired."
    },
    {
      "id": "asking-questions",
      "title": "Asking questions",
      "goal": "ask what, who, where, when, how and why."
    },
    {
      "id": "when-i-dont-understand",
      "title": "When I don't understand",
      "goal": "say you don't understand or don't know, and say sorry."
    },
    {
      "id": "can-you-help-me",
      "title": "Can you help me?",
      "goal": "ask for help politely and say what you can and need."
    }
  ],
