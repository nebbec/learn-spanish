  "tips": [
    {
      "id": "tip-verb-endings",
      "title": "Verbs change with who does them",
      "body": "In English most verbs stay the same: I go, you go. In Spanish the ending changes with the person. Voy means I go, and vas means you go. Because the ending already says who, Spanish usually leaves out yo and tú.",
      "examples": [
        { "es": "Voy a casa.", "en": "I'm going home.", "audio": "/deck/audio/tip-verb-endings.1.a12bcfc8.mp3" },
        { "es": "¿Vas a casa?", "en": "Are you going home?", "audio": "/deck/audio/tip-verb-endings.2.f84d48e9.mp3" }
      ]
    }
  ],
