  "tips": [
    {
      "id": "tip-accusative",
      "title": "The accusative",
      "body": "In German, der, ein and mein change when a word is the thing you see, have or want. Der becomes den, and ein becomes einen. This only happens with masculine words; die and das stay the same.",
      "examples": [
        {
          "target": "Ich sehe den Mann.",
          "en": "I see the man.",
          "audio": "/deck-de/audio/tip-accusative.1.mp3"
        },
        {
          "target": "Ich habe einen Bruder.",
          "en": "I have a brother.",
          "audio": "/deck-de/audio/tip-accusative.2.mp3"
        }
      ]
    }
  ],
